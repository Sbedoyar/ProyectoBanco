{
  "schemaVersion": 1,
  "checks": [
    {
      "id": "presentation-boundary",
      "command": "node specs/004-navegacion-modulos/check-invariants.mjs",
      "cwd": ".",
      "timeoutMs": 30000
    },
    {
      "id": "frontend-unit",
      "command": "npm.cmd run test -- --run",
      "cwd": "frontend",
      "timeoutMs": 120000
    },
    {
      "id": "frontend-build",
      "command": "npm.cmd run build",
      "cwd": "frontend",
      "timeoutMs": 120000
    },
    {
      "id": "frontend-lint",
      "command": "npm.cmd run lint",
      "cwd": "frontend",
      "timeoutMs": 120000
    },
    {
      "id": "frontend-format",
      "command": "npm.cmd run format:check",
      "cwd": "frontend",
      "timeoutMs": 120000
    },
    {
      "id": "backend-build",
      "command": "mvnw.cmd -B -ntp -DskipTests package",
      "cwd": "backend",
      "timeoutMs": 180000
    },
    {
      "id": "backend-integration",
      "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/test-backend.ps1",
      "cwd": ".",
      "timeoutMs": 180000
    },
    {
      "id": "ui-e2e",
      "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/test-ui.ps1",
      "cwd": ".",
      "kind": "ui",
      "timeoutMs": 300000
    },
    {
      "id": "backend-docs",
      "command": "mvnw.cmd -B -ntp javadoc:javadoc",
      "cwd": "backend",
      "timeoutMs": 180000
    }
  ]
}
